# Copier ce fichier en .env et renseigner les valeurs reelles.
# Le fichier .env ne doit JAMAIS etre versionne (il contient des secrets).

# --- Base -------------------------------------------------------------------
# Generer une cle : python manage.py generer_secret_key (ne jamais la coller
# ici a la main ni l'afficher a l'ecran, voir la commande elle-meme).
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=innovation.dxteriz.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://innovation.dxteriz.com,http://localhost,http://127.0.0.1
SITE_URL=https://innovation.dxteriz.com/dr_depannage

# Prefixe de deploiement : nginx fait proxy_pass /dr_depannage/ -> Django /
# (prefixe retire avant d'atteindre Django). Vide ("") si l'appli est servie
# a la racine du domaine plutot que derriere ce reverse proxy partage.
BASE_PATH=/dr_depannage

# --- Base de donnees --------------------------------------------------------
# SQLite convient au developpement ; passer a PostgreSQL en production.
# DATABASE_URL=postgres://utilisateur:motdepasse@serveur:5432/depannages

# --- Courriel (initialisation de compte, mot de passe oublie) ---------------
# Gmail exige un "mot de passe d'application" (compte Google > Securite >
# Validation en deux etapes > Mots de passe des applications), PAS le mot de
# passe du compte. Le coller ici sans espaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=dataquant.pwdreset@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Gestion des depannages <dataquant.pwdreset@gmail.com>

# Tant que EMAIL_HOST_PASSWORD est vide, les courriels s'affichent dans la
# console au lieu d'etre envoyes (pratique en developpement).

# --- Mots de passe ----------------------------------------------------------
# Duree de validite du mot de passe provisoire envoye a la creation du compte.
MOT_DE_PASSE_PROVISOIRE_JOURS=7
# Duree de validite du lien "mot de passe oublie", en secondes (2 h).
PASSWORD_RESET_TIMEOUT=7200

# --- Cache ------------------------------------------------------------------
# Obligatoire des qu'il y a plus d'un processus/worker : sinon le plafond de
# tentatives de connexion est compte separement par chaque processus.
# CACHE_URL=redis://127.0.0.1:6379/1

# --- WebAuthn (connexion par empreinte) -------------------------------------
# WEBAUTHN_RP_ID doit etre le domaine seul (sans schema, sans port, sans
# prefixe de chemin) ; WEBAUTHN_ORIGIN inclut le schema.
WEBAUTHN_RP_ID=innovation.dxteriz.com
WEBAUTHN_RP_NAME=Gestion des depannages
WEBAUTHN_ORIGIN=https://innovation.dxteriz.com

# --- Fond de carte (page Carte) ----------------------------------------------
# Compte gratuit sur maptiler.com, cle a restreindre par domaine dans le
# tableau de bord MapTiler. Sans cle, la carte reste utilisable (contours de
# communes/quartiers + points) mais sans fond de rues/lieux-dits.
MAPTILER_KEY=
